@using Nop.Plugin.Widgets.TTBOLTCarousel.Domain
@using Nop.Plugin.Widgets.TTBOLTCarousel.Utilities
@using Nop.Services.Media
@model List<SliderItem>
@inject IPictureService PictureService
@inject INopHtmlHelper NopHtml

@{
    var slides = (Model ?? new List<SliderItem>()).Where(slide => slide.PictureId.HasValue).ToList();
    var first = slides.FirstOrDefault();

    if (first?.PictureId != null)
    {
        var preloadUrl = PictureUrlFormatter.EncodePath(await PictureService.GetPictureUrlAsync(first.PictureId.Value, targetSize: 1280));
        NopHtml.AddHeadCustomParts($"<link rel=\"preload\" as=\"image\" href=\"{HtmlEncoder.Default.Encode(preloadUrl)}\">");
    }
}

<link href="~/Plugins/Widgets.TTBOLTCarousel/Content/css/swiper-bundle.min.css" rel="stylesheet">
<script src="~/Plugins/Widgets.TTBOLTCarousel/Content/js/swiper-bundle.min.js" asp-location="Footer"></script>

<style>
    .home-slider {
        height: auto;
    }

    .home-slider .swiper-wrapper,
    .home-slider .swiper-slide {
        height: auto;
    }

    .home-slider .swiper-slide {
        background: transparent;
        display: block;
        font-size: inherit;
        text-align: initial;
    }

    .home-slider .swiper-slide a,
    .home-slider .swiper-slide img {
        display: block;
        width: 100%;
    }

    .home-slider .swiper-slide img {
        height: auto;
        object-fit: contain;
    }
</style>

<div class="swiper home-slider">
    <div class="swiper-wrapper">
        @for (var i = 0; i < slides.Count; i++)
        {
            var slide = slides[i];
            var url1280 = PictureUrlFormatter.EncodePath(await PictureService.GetPictureUrlAsync(slide.PictureId.Value));
            var url1920 = PictureUrlFormatter.EncodePath(await PictureService.GetPictureUrlAsync(slide.PictureId.Value, targetSize: 1920));
            var url640 = PictureUrlFormatter.EncodePath(slide.MobilePictureId.HasValue
                ? await PictureService.GetPictureUrlAsync(slide.MobilePictureId.Value, targetSize: 640)
                : await PictureService.GetPictureUrlAsync(slide.PictureId.Value, targetSize: 640));

            <div class="swiper-slide">
                <a href="@slide.RouteLink">
                    <img src="@url1280"
                         srcset="@url640 640w, @url1280 1280w, @url1920 1920w"
                         sizes="(max-width:910px) 100vw, 1200px"
                         alt="@(slide.ImageAlt ?? "")"
                         decoding="async"
                         @(i == 0 ? "fetchpriority=\"high\"" : "loading=\"lazy\"") />
                </a>
            </div>
        }
    </div>

    <div class="swiper-pagination"></div>
    <div class="swiper-button-prev"></div>
    <div class="swiper-button-next"></div>
</div>

<script asp-location="Footer">
    document.addEventListener('DOMContentLoaded', function () {
      new Swiper('.home-slider', {
        autoHeight: true,
        loop: true,
        effect: 'fade',
        pagination: { el: '.home-slider .swiper-pagination', dynamicBullets: true },
        navigation: { nextEl: '.home-slider .swiper-button-next', prevEl: '.home-slider .swiper-button-prev' },
        autoplay: { delay: 4000 }
      });
    });
</script>
