@model ProductDetailsModel

@{
    var addtocomparelink = Url.RouteUrl(NopRouteNames.Ajax.ADD_PRODUCT_TO_COMPARE, new { productId = Model.Id });
}

@if (Model.CompareProductsEnabled)
{
    <div class="compare-products">
        <button type="button" class="button-2 add-to-compare-list-button" onclick="AjaxCart.addproducttocomparelist('@addtocomparelink');return false;">
            <i class="fa-solid fa-code-compare" aria-hidden="true"></i>
            <span>@T("Products.Compare.AddToCompareList")</span>
        </button>
    </div>
}
