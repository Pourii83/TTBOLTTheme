@model SliderItemModel

<div asp-validation-summary="All"></div>
<input asp-for="Id" type="hidden" />

@if (ViewBag.RefreshPage == true)
{
    <script>
        try { window.opener.document.forms['@(Context.Request.Query["formId"])'].@(Context.Request.Query["btnId"]).click(); }
        catch (e) { }
        window.close();
    </script>
}

<div class="cards-group">
    <div class="card card-default card-popup">
        <div class="card-body">
            <div class="form-group row">
                <div class="col-sm-3">
                    <nop-label asp-for="LanguageId" />
                </div>
                <div class="col-sm-9">
                    <nop-select asp-for="LanguageId" asp-items="Model.AvailableLanguages" />
                    <span asp-validation-for="LanguageId"></span>
                </div>
            </div>
            <div class="form-group row">
                <div class="col-sm-3">
                    <nop-label asp-for="RouteLink" />
                </div>
                <div class="col-sm-9">
                    <nop-editor asp-for="RouteLink" />
                    <span asp-validation-for="RouteLink"></span>
                </div>
            </div>
            <div class="form-group row">
                <div class="col-sm-3">
                    <nop-label asp-for="Order" />
                </div>
                <div class="col-sm-9">
                    <nop-editor asp-for="Order" />
                    <span asp-validation-for="Order"></span>
                </div>
            </div>
            <div class="form-group row">
                <div class="col-sm-3">
                    <nop-label asp-for="PictureId" />
                </div>
                <div class="col-sm-9">
                    <nop-editor asp-for="PictureId" />
                    <span asp-validation-for="PictureId"></span>
                </div>
            </div>
            <div class="form-group row">
                <div class="col-sm-3">
                    <nop-label asp-for="MobilePictureId" />
                </div>
                <div class="col-sm-9">
                    <nop-editor asp-for="MobilePictureId" />
                    <span asp-validation-for="MobilePictureId"></span>
                </div>
            </div>
            <div class="form-group row">
                <div class="col-sm-3">
                    <nop-label asp-for="ImageAlt" />
                </div>
                <div class="col-sm-9">
                    <nop-editor asp-for="ImageAlt" />
                    <span asp-validation-for="ImageAlt"></span>
                </div>
            </div>
        </div>
    </div>
</div>
