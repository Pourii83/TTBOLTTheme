@model MenuModel

@using Nop.Core.Domain.Menus;

<script src="~/js/public.menu.js" asp-location="Footer"></script>
<script asp-location="Footer">
    mainMenu.init('.menu-container .menu__toggle, .menu-container .menu__item-toggle', 'menu-dropdown--active');
    $(function () {
        var menuContainer = $('.header-menu > .menu-container');

        $('.header-menu .menu__toggle').on('click', function () {
            setTimeout(function () {
                $('body').toggleClass('mobile-menu-open', menuContainer.hasClass('menu-dropdown--active'));
            }, 0);
        });

        $(document).on('click', function (event) {
            if (!$(event.target).closest('.header-menu').length) {
                $('body').removeClass('mobile-menu-open');
                menuContainer.removeClass('menu-dropdown--active');
            }
        });

        $('.header-menu .menu__close').on('click', function () {
            $('body').removeClass('mobile-menu-open');
            menuContainer.removeClass('menu-dropdown--active');
        });
    });
</script>


<nav class="menu-container menu-dropdown">
    <div id="menu-@Model.Id" class="menu__toggle" role="button">@Model.Name</div>
    <div role="menu" class="menu @Model.CssClass" aria-labelledby="menu-@Model.Id">
        <div class="menu__drawer-head">
            <span class="menu__drawer-title">@Model.Name</span>
            <button type="button" class="menu__close" aria-label="@T("Common.Close")">
                <i class="fa-solid fa-xmark" aria-hidden="true"></i>
            </button>
        </div>
        @foreach (var menuItem in Model.Items)
        {
            @if (menuItem.ChildrenItems.Any())
            {
                @switch (menuItem.Template)
                {
                    case MenuItemTemplate.Grid:
                        @await Html.PartialAsync("_MenuItem.Grid.cshtml", menuItem)
                        break;
                    default:
                        @await Html.PartialAsync("_MenuItem.List.cshtml", menuItem)
                        break;
                }
            }
            else
            {
                <div class="menu__item @menuItem.CssClass" role="menuitem">
                    @await Html.PartialAsync("_MenuItem.cshtml", menuItem)
                </div>
            }
        }
    </div>
</nav>
