@model NewsItemCardHeaderModel
@inject INopUrlHelper NopUrl

@using Nop.Core.Domain.News

@{
    NopHtml.AppendCssFileParts("~/Plugins/Misc.TTBOLTContentSuite/Content/css/ttbolt-contentsuite.css");
}

<div class="ttbolt-news-card__header ttbolt-blog-card__header">
    <a class="ttbolt-news-card__media ttbolt-blog-card__media"
       href="@(await NopUrl.RouteGenericUrlAsync<NewsItem>(new { SeName = Model.SeName }))"
       title="@Model.Title">
        <img src="@Model.PictureUrl" alt="@Model.Title" loading="lazy" />
    </a>
    <div class="ttbolt-news-card__meta ttbolt-blog-card__meta">
        @if (!string.IsNullOrEmpty(Model.CustomerName))
        {
            <span class="ttbolt-blog-card__author">
                @if (!string.IsNullOrEmpty(Model.CustomerAvatarUrl))
                {
                    <img src="@Model.CustomerAvatarUrl" alt="@Model.CustomerName" loading="lazy" />
                }
                else
                {
                    <i class="fa-solid fa-user" aria-hidden="true"></i>
                }
                <span>@Model.CustomerName</span>
            </span>
        }
        <time datetime="@Model.CreatedOn.ToString("yyyy-MM-dd")"
              title="@T("Plugins.Misc.TTBOLTContentSuite.NewsItem.PublishedOn")">
            <i class="fa-regular fa-calendar" aria-hidden="true"></i>
            @Model.CreatedOn.ToString("D")
        </time>
        @if (Model.UpdatedOn.HasValue)
        {
            <time datetime="@Model.UpdatedOn.Value.ToString("yyyy-MM-dd")"
                  title="@T("Plugins.Misc.TTBOLTContentSuite.NewsItem.UpdatedOn")">
                <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i>
                @Model.UpdatedOn.Value.ToString("D")
            </time>
        }
    </div>
</div>
